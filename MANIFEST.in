include LICENSE README.md CHANGELOG.md CITATION.cff codemeta.json
include REPRODUCIBILITY.md SECURITY.md SUPPORT.md THIRD_PARTY_NOTICES.md
include FINAL_VENUE_DECISION.md FINAL_VALIDATION_REPORT.md SUBMISSION_CHECKLIST.md REMAINING_BLOCKERS.md
include CONTRIBUTING.md CODE_OF_CONDUCT.md GOVERNANCE.md VENUE_TARGET.md
recursive-include configs *.json
recursive-include docs *.md
recursive-include examples *.py *.json
recursive-include artifact *.md *.json *.py
recursive-include experiments *.py *.json *.csv *.pdf *.png
recursive-include paper *.tex *.sty *.bst *.bib *.pdf
recursive-include submission *.md
recursive-include tests *.py
prune build
prune .pytest_cache
global-exclude *.py[cod] __pycache__ .DS_Store
