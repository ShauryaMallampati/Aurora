include LICENSE README.md CHANGELOG.md CITATION.cff codemeta.json CREDITS.md START_HERE.md
include REPRODUCIBILITY.md SECURITY.md SUPPORT.md THIRD_PARTY_NOTICES.md
include CONTRIBUTING.md CODE_OF_CONDUCT.md GOVERNANCE.md
recursive-include configs *.json
recursive-include docs *.md
recursive-include examples *.py *.json
recursive-include artifact *.md *.json *.py
recursive-include experiments *.py *.json *.csv *.pdf *.png
recursive-include tests *.py
prune build
prune .pytest_cache
global-exclude *.py[cod] __pycache__ .DS_Store
